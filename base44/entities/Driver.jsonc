{
  "name": "Driver",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "title": "First Name"
    },
    "last_name": {
      "type": "string",
      "title": "Last Name"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "vehicle_type": {
      "type": "string",
      "title": "Vehicle Type",
      "enum": [
        "Car",
        "Van",
        "Box Truck",
        "Sprinter",
        "Semi",
        "Motorcycle",
        "Other"
      ]
    },
    "vehicle_make": {
      "type": "string",
      "title": "Make"
    },
    "vehicle_model": {
      "type": "string",
      "title": "Model"
    },
    "license_plate": {
      "type": "string",
      "title": "License Plate"
    },
    "pay_type": {
      "type": "string",
      "title": "Pay Type",
      "enum": [
        "Per Mile",
        "Per Job",
        "Hourly",
        "Percentage"
      ]
    },
    "pay_rate": {
      "type": "number",
      "title": "Pay Rate"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Active",
        "Inactive",
        "On Leave"
      ],
      "default": "Active"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "lat": {
      "type": "number",
      "title": "Last Latitude"
    },
    "lng": {
      "type": "number",
      "title": "Last Longitude"
    },
    "last_location_update": {
      "type": "string",
      "title": "Last Location Update"
    },
    "is_tracking": {
      "type": "boolean",
      "title": "GPS Tracking Active"
    }
  },
  "required": []
}