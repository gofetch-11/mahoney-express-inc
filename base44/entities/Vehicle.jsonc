{
  "name": "Vehicle",
  "type": "object",
  "properties": {
    "unit_number": {
      "type": "string",
      "title": "Unit Number"
    },
    "make": {
      "type": "string",
      "title": "Make"
    },
    "model": {
      "type": "string",
      "title": "Model"
    },
    "year": {
      "type": "number",
      "title": "Year"
    },
    "vin": {
      "type": "string",
      "title": "VIN"
    },
    "license_plate": {
      "type": "string",
      "title": "License Plate"
    },
    "vehicle_type": {
      "type": "string",
      "title": "Type",
      "enum": [
        "Car",
        "Van",
        "Sprinter",
        "Box Truck",
        "Semi",
        "Motorcycle",
        "Other"
      ]
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Active",
        "In Service",
        "Out of Service",
        "Retired"
      ],
      "default": "Active"
    },
    "current_mileage": {
      "type": "number",
      "title": "Current Mileage"
    },
    "last_service_mileage": {
      "type": "number",
      "title": "Last Service Mileage"
    },
    "next_service_mileage": {
      "type": "number",
      "title": "Next Service Mileage"
    },
    "last_service_date": {
      "type": "string",
      "title": "Last Service Date"
    },
    "assigned_driver_id": {
      "type": "string",
      "title": "Assigned Driver ID"
    },
    "assigned_driver_name": {
      "type": "string",
      "title": "Assigned Driver"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "unit_number"
  ]
}